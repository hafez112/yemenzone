// ═══════════════════════════════════════════════════════════════
//  منصة يمن زون — مخطط قاعدة البيانات الكامل (Prisma / PostgreSQL)
//  الجلسة 1 — يغطي جميع أنظمة المنصة الـ14
// ═══════════════════════════════════════════════════════════════

// Prisma 7 — مولّد TypeScript الجديد (بدون محرك Rust): أسرع 3× وأخف 90%
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── التعدادات العامة ─────────────────────────
enum StoreKind {
  products // متجر منتجات
  rentals // وحدات إيجار
  hotel // فندق (غرف)
  services // خدمات
  restaurants // مطعم (منيو وطلبات)
  malls // مول تجاري (سوق إلكتروني شامل بأصناف رئيسية وفرعية)
}

enum UserStatus {
  active
  suspended
  banned
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  completed
  cancelled
  refunded
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled
}

enum PaymentStatus {
  pending // بانتظار مراجعة الإثبات
  approved
  rejected
  refunded // ↩️ أُعيد المبلغ للعميل (استرجاع مقبول)
}

enum TxType {
  credit // إيداع
  debit // خصم
}

enum WithdrawStatus {
  pending
  paid
  rejected
}

enum MessageChannel {
  sms
  whatsapp
  both
}

enum ComplaintStatus {
  open
  replied
  closed
}

enum DeviceStatus {
  pending // بانتظار اعتماد
  approved
  blocked
}

// ═══ 1) المصادقة والمستخدمون ═══════════════════

// البائعون (أصحاب المتاجر)
model Seller {
  id           String     @id @default(cuid())
  phone        String     @unique
  name         String
  email        String?    @unique
  passwordHash String? // Argon2 — اختياري مع OTP
  avatar       String?
  status       UserStatus @default(active)
  googleId     String?    @unique
  lastLoginAt  DateTime?
  // 🤝 إحالة التجار — كل بائع له رمز دعوة خاص، ويُسجَّل من دعاه
  referralCode String?   @unique
  referredById String?
  referredBy   Seller?   @relation("SellerReferrals", fields: [referredById], references: [id])
  referrals    Seller[]  @relation("SellerReferrals")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  stores      Store[]
  wallet      Wallet?
  sessions    Session[]
  settlements Settlement[]
  otpCodes    OtpCode[]
  cards       CustomerCard[]
  cardTopups  CardTopup[]

  @@map("sellers")
}

// العملاء
model Customer {
  id           String     @id @default(cuid())
  phone        String     @unique
  name         String
  passwordHash String?
  avatar       String?
  status       UserStatus @default(active)
  governorate  String?
  address      String?
  lat          Float?
  lng          Float?
  lastLoginAt  DateTime?
  // 🎁 نظام الإحالة والنقاط
  referralCode String     @unique @default(cuid()) // رمز إحالة خاص بكل عميل
  referredById String? // من دعاه (معرّف العميل المُحيل)
  points       Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders          Order[]
  rentalBookings  RentalBooking[]
  roomBookings    RoomBooking[]
  serviceRequests ServiceRequest[]
  reviews         Review[]
  storeLikes      StoreLike[]
  cards           CustomerCard[]
  topups          CardTopup[]
  complaints      Complaint[]
  sessions        Session[]
  otpCodes        OtpCode[]
  referralsMade   Referral[]          @relation("referrer")
  referralUsed    Referral?           @relation("referred")
  pointsTxns      PointsTransaction[]
  conversations   Conversation[]
  wishlist        WishlistItem[]
  questions       ProductQuestion[]
  cartItems       CartItem[]

  @@map("customers")
}

// 🎁 سجل الإحالات — من دعا من
model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    Customer @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String   @unique // عميل واحد يُحال مرة واحدة فقط
  referred    Customer @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)
  pointsGiven Int      @default(0) // نقاط منحها النظام للطرفين
  createdAt   DateTime @default(now())

  @@index([referrerId])
  @@map("referrals")
}

// 🎁 دفتر حركات النقاط — كسب (+) وصرف (−)
model PointsTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int // موجب = كسب، سالب = صرف
  reason     String
  refId      String? // مرجع الحركة (طلب خدمة/إحالة)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("points_transactions")
}

// مدراء المنصة (متعددون بصلاحيات)
model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  isSuper      Boolean    @default(false)
  permissions  Json       @default("[]") // ["stores","finance","design",...]
  status       UserStatus @default(active)
  totpSecret   String? // 🔐 سر المصادقة الثنائية (مشفّر)
  totpEnabled  Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("admin_users")
}

// 📜 سجل التدقيق الإداري — كل إجراء إداري: من فعل، ماذا، متى، من أين
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  adminName String?
  method    String // POST | PATCH | PUT | DELETE
  path      String // /api/admin/stores/...
  status    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// رموز OTP (تعمل فقط عند تفعيل قالب OTP من الإدارة)
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  purpose    String // register | login | card-verify | reset
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  sellerId   String?
  seller     Seller?   @relation(fields: [sellerId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([phone, purpose])
  @@map("otp_codes")
}

// جلسات الدخول (Refresh Tokens)
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  deviceInfo String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  sellerId   String?
  seller     Seller?   @relation(fields: [sellerId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@map("sessions")
}

// ═══ 2) المتاجر وأنواعها ══════════════════════

// أنواع المتاجر — kind هو «النشاط الأساسي» (محرك العرض واللوحة)،
// ويمكن أن تتعدد الأنواع على نفس النشاط (مطعم/صيدلية/بوتيك كلها منتجات)
model StoreType {
  id          String    @id @default(cuid())
  kind        StoreKind
  nameAr      String
  nameEn      String?
  icon        String?
  color       String?
  description String?
  sort        Int       @default(0)
  isActive    Boolean   @default(true)
  stores      Store[]

  @@index([kind])
  @@map("store_types")
}

// المتاجر
model Store {
  id                 String     @id @default(cuid())
  sellerId           String
  seller             Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  typeId             String
  type               StoreType  @relation(fields: [typeId], references: [id])
  name               String
  slug               String     @unique // نطاق فرعي: slug.yemenzone.com
  logo               String?
  cover              String?
  description        String?
  governorate        String?
  city               String?
  address            String?
  lat                Float?
  lng                Float?
  whatsapp           String?
  phone              String?
  // تخصيص قالب المتجر
  themeJson          Json       @default("{}") // ألوان/خط/قالب
  template           String     @default("default")
  // 📨 قوالب الرسائل الآلية للعملاء — لكل حالة طلب نصاً مخصصاً (اختياري)
  messageTemplates   Json       @default("{}")
  // التوثيق والدرجة الذكية
  isVerified         Boolean    @default(false)
  smartScore         Float      @default(0) // درجة ذكية محسوبة
  // 🌐 النطاق الحقيقي الخاص بالمتجر — بموافقة الإدارة فقط
  customDomain       String?    @unique // مثل: shop.example.com
  customDomainStatus String     @default("none") // none | pending | approved | rejected
  customDomainNote   String? // سبب الرفض أو ملاحظة الإدارة
  domainRequestedAt  DateTime?
  ratingAvg          Float      @default(0)
  ratingCount        Int        @default(0)
  // التمييز — بموافقة الإدارة فقط
  isFeatured         Boolean    @default(false) // يظهر في "المتاجر المتميزة"
  featuredAt         DateTime?
  // 🗂️ الظهور في دليل المتاجر — لا يُفعّل إلا بموافقة الإدارة (المتاجر الجديدة مخفية حتى الموافقة)
  isListed           Boolean    @default(false)
  listedAt           DateTime?
  featuredRequested  Boolean    @default(false) // البائع طلب التمييز — بانتظار موافقة الإدارة
  // صلاحيات استثنائية تمنحها الإدارة لهذا المتجر (تتجاوز حدود الخطة)
  grants             Json       @default("{}") // مثل: {"analytics":true,"api":true}
  // 🤝 عمولة مخصصة لهذا المتجر (% — فارغ = النسبة العامة للمنصة)
  commissionPercent  Float?
  likesCount         Int        @default(0)
  viewsCount         Int        @default(0)
  // SEO
  metaTitle          String?
  metaDesc           String?
  keywords           String? // كلمات مفتاحية مفصولة بفواصل — يضبطها البائع
  status             UserStatus @default(active)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  products             Product[]
  categories           Category[]
  orders               Order[]
  rentalUnits          RentalUnit[]
  rooms                HotelRoom[]
  services             ServiceItem[]
  reviews              Review[]
  likes                StoreLike[]
  subscription         Subscription?
  deliveryCompanies    StoreDeliveryCompany[]
  drivers              StoreDriver[]
  apiKeys              ApiKey[]
  verificationRequests VerificationRequest[]
  paymentMethods       StorePaymentMethod[]
  conversations        Conversation[]
  deliveryMethods      StoreDeliveryMethod[]
  cartItems            CartItem[]

  @@index([governorate])
  @@index([smartScore])
  @@map("stores")
}

// 💳 طرق الدفع الخاصة بالمتجر — يضبطها البائع وتظهر لعملائه عند إتمام الطلب
model StorePaymentMethod {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type         String // cash | wallet | bank | transfer
  label        String // الاسم الظاهر للعميل: "محفظة الكريمي — جوال"
  account      String? // رقم المحفظة / الحساب / الحوالة
  accountName  String? // اسم صاحب الحساب
  instructions String? // تعليمات الدفع للعميل
  fee          Float    @default(0) // رسوم ثابتة تُضاف للطلب
  isActive     Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([storeId, isActive])
  @@map("store_payment_methods")
}

// 🚚 طرق التوصيل الخاصة بالمتجر — يحددها البائع: توصيل منزلي، استلام، شركة...
model StoreDeliveryMethod {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String // "توصيل للمنزل" | "استلام من المتجر"
  fee       Float    @default(0)
  eta       String? // المدة التقريبية: "30-60 دقيقة"
  areas     String? // المناطق المخدومة
  note      String? // ملاحظة للعميل
  isActive  Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storeId, isActive])
  @@map("store_delivery_methods")
}

// 🎖️ طلبات توثيق المتاجر — البائع يرفع مستنداته والإدارة تراجع وتعتمد
model VerificationRequest {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docType      String // id بطاقة شخصية | commercial سجل تجاري | other أخرى
  docImage     String // صورة المستند /uploads/docs/…
  notes        String? // ملاحظات البائع
  status       String    @default("pending") // pending | approved | rejected
  rejectReason String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId, status])
  @@map("verification_requests")
}

// 📰 مدونة المنصة — محتوى SEO يُدار من لوحة الإدارة بمحرر TipTap
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String? // مقتطف للبطاقات ومحركات البحث
  content     String // HTML غني — مُطهّر في الخادم
  cover       String?
  videoUrl    String? // فيديو توضيحي: رابط يوتيوب أو /uploads/videos/…
  category    String? // تصنيف نصي (تسويق/شروحات/قصص نجاح…)
  tags        String? // كلمات مفتاحية مفصولة بفواصل
  metaDesc    String?
  views       Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

// 🔍 سجل البحث العام — كلمات الزوار لتغذية الذكاء المحلي
model SearchQuery {
  id           String   @id @default(cuid())
  term         String
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([term])
  @@map("search_queries")
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  image    String?
  sort     Int       @default(0)
  // 🏬 أصناف فرعية تابعة لصنف رئيسي (المولات التجارية) — مستوى واحد فقط
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("SubCategories")
  products Product[]
  @@index([storeId, sort])
  @@index([storeId, parentId])

  @@map("categories")
}

// المنتجات
model Product {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  name           String
  description    String?
  // 🏬 حقول المول: وصف مختصر + كلمات مفتاحية + SEO + تمييز
  shortDesc      String?
  keywords       String?
  metaTitle      String?
  metaDesc       String?
  isFeatured     Boolean   @default(false)
  price          Decimal   @db.Decimal(12, 2)
  salePrice      Decimal?  @db.Decimal(12, 2)
  currency       String    @default("YER")
  stock          Int       @default(0)
  lowStockAt     Int       @default(5) // 🔔 حد التنبيه: تنبيه للبائع عند بلوغه
  stockAlertedAt DateTime? // آخر تنبيه مخزون (يُصفّر عند إعادة التخزين)
  sku            String?
  barcode        String?
  features       Json? // 🏷️ مميزات المنتج: [{key:'الخامة',value:'قطن'}]
  variants       Json? // 🎨 خيارات بأسعار: [{id,color?,size?,price,salePrice?,stock?,sku?}]
  // 🧬 نوع المنتج الفرعي ومواصفاته المنظمة — يحددان شكل نموذج الإضافة وعرض المواصفات
  // productKind: electronics | food | clothing | accessories | spices | nuts | other
  // specs: {brand?, model?, warrantyMonths?, weightGrams?, expiryDate?, material?, gender?, ...} حسب النوع
  productKind    String?
  specs          Json?
  images         Json      @default("[]") // ["webp1","webp2"]
  isActive       Boolean   @default(true)
  viewsCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  stockAlerts   StockAlert[]
  priceAlerts   PriceAlert[]
  wishlistItems WishlistItem[]
  questions     ProductQuestion[]
  cartItems     CartItem[]

  @@index([storeId, isActive])
  @@index([storeId, categoryId, isActive])
  @@index([storeId, createdAt])
  @@index([storeId, isFeatured, isActive])
  @@map("products")
}

// الطلبات (منتجات)
model Order {
  id                 String      @id @default(cuid())
  number             String      @unique // ORD-XXXXXX
  storeId            String
  store              Store       @relation(fields: [storeId], references: [id])
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id])
  customerName       String
  customerPhone      String
  address            String?
  customerLat        Float? // 📍 إحداثيات موقع العميل (اختياري — يشاركها بنفسه)
  customerLng        Float?
  notes              String?
  subtotal           Decimal     @db.Decimal(12, 2)
  deliveryFee        Decimal     @default(0) @db.Decimal(12, 2)
  discount           Decimal     @default(0) @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  currency           String      @default("YER")
  status             OrderStatus @default(pending)
  paymentMethod      String? // cash | card | gateway | store:<طريقة البائع>
  deliveryMethod     String? // اسم طريقة التوصيل التي اختارها العميل من طرق المتجر
  couponId           String?
  driverId           String?
  driver             Driver?     @relation(fields: [driverId], references: [id])
  // 🤝 عمولة المنصة — تُخصم تلقائياً من محفظة البائع عند التسليم
  commissionAmount   Decimal?    @db.Decimal(12, 2)
  commissionCharged  Boolean     @default(false)
  commissionReversed Boolean     @default(false) // عُكست بعد استرجاع
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items   OrderItem[]
  returns ReturnRequest[]

  @@index([storeId, status])
  @@index([customerPhone, createdAt])
  @@index([driverId, status])
  @@index([storeId, createdAt])
  @@map("orders")
}

// ↩️ طلبات الاسترجاع — يقدمها العميل بعد الاستلام، يراجعها البائع
model ReturnRequest {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerName   String
  customerPhone  String
  reason         String // وصف سبب الاسترجاع من العميل
  status         String    @default("pending") // pending | accepted | rejected
  sellerNote     String? // رد البائع (سبب الرفض أو تعليمات الإرجاع)
  refundedAmount Decimal?  @db.Decimal(12, 2) // المبلغ المعاد للعميل (طلبات البطاقة)
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([orderId])
  @@map("return_requests")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  variant   String? // 🎨 الخيار المختار: "أحمر — XL" أو "250غ"
  variantId String?
  price     Decimal @db.Decimal(12, 2)
  qty       Int
  @@index([orderId])
  @@index([productId])

  @@map("order_items")
}

// ═══ 3) الإيجارات والفنادق والخدمات ════════════

model RentalUnit {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String? // شقة/فيلا/محل...
  pricePerDay   Decimal         @db.Decimal(12, 2)
  // 🏠 حقول نشاط الإيجارات — تسعير ومواصفات عقارية حقيقية
  pricePerMonth Decimal?        @db.Decimal(12, 2) // إيجار شهري (اختياري)
  deposit       Decimal?        @db.Decimal(12, 2) // التأمين/العربون
  areaM2        Int? // المساحة بالمتر المربع
  roomsCount    Int? // عدد الغرف
  specs         Json? // مواصفات إضافية: {floor?, furnished?, parking?, ...}
  images        Json            @default("[]")
  features      Json            @default("[]")
  governorate   String?
  address       String?
  isActive      Boolean         @default(true)
  isHidden      Boolean         @default(false) // إخفاء من المدير
  bookings      RentalBooking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([storeId, isActive])

  @@map("rental_units")
}

model RentalBooking {
  id            String        @id @default(cuid())
  unitId        String
  unit          RentalUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  fromDate      DateTime
  toDate        DateTime
  total         Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(pending)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([unitId, status])
  @@index([customerPhone])

  @@map("rental_bookings")
}

model HotelRoom {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title         String
  roomType      String? // مفرد/مزدوج/جناح
  description   String?
  pricePerNight Decimal       @db.Decimal(12, 2)
  capacity      Int           @default(2)
  // 🛎️ حقول نشاط الفنادق
  beds          Int           @default(1) // عدد الأسِرّة
  view          String? // الإطلالة: بحر/مدينة/جبل...
  breakfast     Boolean       @default(false) // يشمل الإفطار
  specs         Json? // مواصفات إضافية: {bathrooms?, wifi?, ac?, ...}
  images        Json          @default("[]")
  features      Json          @default("[]")
  isActive      Boolean       @default(true)
  isHidden      Boolean       @default(false)
  bookings      RoomBooking[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([storeId, isActive])

  @@map("hotel_rooms")
}

model RoomBooking {
  id            String        @id @default(cuid())
  roomId        String
  room          HotelRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int           @default(1)
  total         Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(pending)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([roomId, status])
  @@index([customerPhone])

  @@map("room_bookings")
}

model ServiceItem {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  price        Decimal          @db.Decimal(12, 2)
  duration     String? // مدة التنفيذ (نص حر: "يومان")
  // 🛠️ حقول نشاط الخدمات
  category     String? // تصنيف الخدمة: صيانة/تصميم/تعليم...
  durationMin  Int? // مدة التنفيذ بالدقائق (للترتيب والتقدير)
  warrantyText String? // نص الضمان: "ضمان 30 يوماً"
  specs        Json? // مواصفات إضافية: {includes?, requirements?, ...}
  images       Json             @default("[]")
  isActive     Boolean          @default(true)
  isHidden     Boolean          @default(false)
  requests     ServiceRequest[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([storeId, isActive])

  @@map("service_items")
}

model ServiceRequest {
  id            String        @id @default(cuid())
  serviceId     String
  service       ServiceItem   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  details       String?
  total         Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([serviceId, status])
  @@index([customerPhone])

  @@map("service_requests")
}

// ═══ 4) التقييمات والدرجة الذكية ═══════════════

model Review {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int // 1-5
  comment     String?
  orderId     String? // 🧾 الطلب المرتبط — تقييم موثّق بعد شراء فعلي
  orderNumber String? // رقم الطلب للعرض
  reply       String? // 💬 رد البائع على التقييم
  repliedAt   DateTime?
  replyHidden Boolean   @default(false) // إخفاء الرد (إشراف المدير)
  isApproved  Boolean   @default(true) // إشراف المدير
  images      Json      @default("[]") // 📸 صور المشتري — حتى صورتين
  createdAt   DateTime  @default(now())

  @@index([storeId])
  @@index([storeId, createdAt])
  @@map("reviews")
}

model StoreLike {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, storeId])
  @@index([storeId])
  @@index([customerId])
  @@map("store_likes")
}

// ═══ 5) الخطط والاشتراكات والكوبونات ═══════════

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique // free | basic | pro
  // 🎯 نوع النشاط الذي تناسبه الباقة — فارغ = عامة لكل الأنواع
  // البائع يرى فقط الباقات العامة + باقات نوع متجره
  kind          StoreKind?
  priceMonthly  Decimal        @db.Decimal(12, 2)
  priceYearly   Decimal?       @db.Decimal(12, 2)
  currency      String         @default("YER")
  features      Json           @default("{}") // حدود: منتجات/صور/أنواع متاجر...
  isActive      Boolean        @default(true)
  sort          Int            @default(0)
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String    @id @default(cuid())
  storeId   String    @unique
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id])
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("subscriptions")
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("percent") // percent | fixed
  value     Decimal   @db.Decimal(12, 2)
  minTotal  Decimal   @default(0) @db.Decimal(12, 2) // أدنى إجمالي للطلب لتفعيله
  maxUses   Int?
  usedCount Int       @default(0)
  startsAt  DateTime? // 🗓️ جدولة الحملة — يعمل من هذا التاريخ
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  storeId   String? // كوبون متجر أو منصة
  createdAt DateTime  @default(now())

  @@map("coupons")
}

// ═══ 6) النظام المالي ══════════════════════════

// بوابات الدفع (بنوك/محافظ API)
model PaymentGateway {
  id           String   @id @default(cuid())
  name         String
  provider     String // bank | wallet | card
  apiUrl       String?
  apiKey       String?
  apiSecret    String? // المفتاح السري للبوابة
  merchantId   String? // معرف التاجر للربط التلقائي
  scopes       Json     @default("[]") // نطاقات الاستخدام: orders|topup|subscription
  accountInfo  String? // رقم الحساب/المحفظة للتحويل
  instructions String? // تعليمات الدفع للعميل
  fee          Float    @default(0) // رسوم ثابتة تُضاف للطلب
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("payment_gateways")
}

// سجل المدفوعات + موافقات بمراجعة الإثبات
model Payment {
  id          String        @id @default(cuid())
  number      String        @unique // INV-XXXXXX
  payerType   String // seller | customer
  payerId     String
  purpose     String // subscription | order | topup | pservice
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("YER")
  method      String // cash | card | gateway:<id>
  proofImage  String? // إثبات التحويل
  status      PaymentStatus @default(pending)
  gatewayId   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  referenceId String? // ربط بالطلب/الاشتراك
  createdAt   DateTime      @default(now())

  @@index([status, purpose])
  @@index([payerType, payerId])
  @@index([referenceId])
  @@map("payments")
}

// دفعات توليد البطاقات
model CardBatch {
  id        String        @id @default(cuid())
  name      String
  count     Int
  value     Decimal       @db.Decimal(12, 2)
  currency  String        @default("YER")
  createdAt DateTime      @default(now())
  cards     PaymentCard[]

  @@map("card_batches")
}

// بطاقات الدفع الإلكترونية
model PaymentCard {
  id         String     @id @default(cuid())
  batchId    String?
  batch      CardBatch? @relation(fields: [batchId], references: [id])
  cardNumber String     @unique
  pin        String
  value      Decimal    @db.Decimal(12, 2)
  currency   String     @default("YER")
  isUsed     Boolean    @default(false)
  isDisabled Boolean    @default(false)
  usedBy     String?
  usedAt     DateTime?
  createdAt  DateTime   @default(now())

  @@map("payment_cards")
}

// 💳 بطاقة يمن زون — للعملاء والبائعين: رصيد + بيانات مالك + إيقاف من الإدارة
model CustomerCard {
  id         String      @id @default(cuid())
  ownerType  String      @default("customer") // customer | seller
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId   String?
  seller     Seller?     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  holderName String? // 👤 اسم صاحب البطاقة — تعدّله الإدارة بطلب من المالك
  phone      String? // 📱 الجوال المرتبط بالبطاقة
  note       String? // ملاحظات الإدارة الداخلية
  cardNumber String      @unique
  balance    Decimal     @default(0) @db.Decimal(12, 2)
  currency   String      @default("YER")
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  topups     CardTopup[]
  editRequests CardEditRequest[]
  purchases  ToolPurchase[]

  @@index([ownerType, customerId])
  @@index([ownerType, sellerId])
  @@map("customer_cards")
}

// طلبات شحن البطاقات (بموافقة المدير)
model CardTopup {
  id         String        @id @default(cuid())
  cardId     String
  card       CustomerCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  sellerId   String?
  seller     Seller?       @relation(fields: [sellerId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     String // payment-card | gateway | transfer
  proofImage String?
  status     PaymentStatus @default(pending)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  @@map("card_topups")
}

// 📝 طلب تعديل بيانات البطاقة — يرسله المالك (عميل/بائع) وتنفذه الإدارة أو ترفضه
model CardEditRequest {
  id        String       @id @default(cuid())
  cardId    String
  card      CustomerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  ownerType String // customer | seller
  ownerId   String
  holderName String? // الاسم المطلوب (إن طُلب تغييره)
  phone      String? // الجوال المطلوب (إن طُلب تغييره)
  message   String? // رسالة المالك للإدارة
  status    String       @default("pending") // pending | approved | rejected
  adminNote String?
  createdAt DateTime     @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@map("card_edit_requests")
}

// 🛒 مشتريات الخدمات المدفوعة — الدفع ببطاقة يمن زون فقط، والشراء يفتح الخدمة دائماً
model ToolPurchase {
  id        String       @id @default(cuid())
  ownerType String // customer | seller
  ownerId   String
  slug      String // مفتاح الخدمة
  amount    Decimal      @db.Decimal(12, 2)
  currency  String       @default("YER")
  cardId    String
  card      CustomerCard @relation(fields: [cardId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([ownerType, ownerId, slug])
  @@index([ownerType, ownerId])
  @@map("tool_purchases")
}

// محفظة البائع
model Wallet {
  id           String              @id @default(cuid())
  sellerId     String              @unique
  seller       Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("YER")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TxType
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  referenceId String? // رقم الطلب/الدفع
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id          String         @id @default(cuid())
  walletId    String
  wallet      Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(12, 2)
  method      String? // حوالة/بنك...
  accountInfo String?
  status      WithdrawStatus @default(pending)
  note        String?
  createdAt   DateTime       @default(now())
  processedAt DateTime?

  @@map("withdrawal_requests")
}

// 📋 كشف التسوية — بيان مالي دوري لكل بائع: مبيعات الفترة، عمولة المنصة، المرتجعات، الصافي
model Settlement {
  id          String    @id @default(cuid())
  number      String    @unique // ST-XXXXXX
  sellerId    String
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  ordersCount Int       @default(0)
  gross       Decimal   @default(0) @db.Decimal(12, 2) // إجمالي مبيعات الفترة
  commission  Decimal   @default(0) @db.Decimal(12, 2) // عمولة المنصة المخصومة
  refunds     Decimal   @default(0) @db.Decimal(12, 2) // المرتجعات المعتمدة
  net         Decimal   @default(0) @db.Decimal(12, 2) // صافي البائع بعد العمولة والمرتجعات
  status      String    @default("issued") // issued | paid | cancelled
  note        String?
  issuedBy    String? // المدير الذي أصدره
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([sellerId, createdAt])
  @@map("settlements")
}

// ═══ 7) التوصيل ════════════════════════════════

model Driver {
  id           String        @id @default(cuid())
  phone        String        @unique
  name         String
  passwordHash String?
  vehicle      String?
  governorate  String?
  isActive     Boolean       @default(true)
  // 📍 الموقع المباشر — يشاركه السائق بقراره أثناء التوصيل
  lat          Float?
  lng          Float?
  locationAt   DateTime?
  createdAt    DateTime      @default(now())
  orders       Order[]
  stores       StoreDriver[]

  @@map("drivers")
}

model DeliveryCompany {
  id        String                 @id @default(cuid())
  name      String
  apiUrl    String?
  apiKey    String?
  panelUrl  String? // رابط لوحة الشركة
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  stores    StoreDeliveryCompany[]

  @@map("delivery_companies")
}

// ربط شركات التوصيل بالبائعين
model StoreDeliveryCompany {
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  companyId String
  company   DeliveryCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([storeId, companyId])
  @@map("store_delivery_companies")
}

// 🛵 ربط السائقين بمتاجر البائعين — الإدارة تسند السائق لمتجر معين
model StoreDriver {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, driverId])
  @@map("store_drivers")
}

// 🗂️ ملفات المنصة — مدير الملفات في لوحة الإدارة (مرتبط بقاعدة البيانات)
model PlatformFile {
  id         String   @id @default(cuid())
  name       String // الاسم الظاهر
  path       String   @unique // /uploads/files/...
  size       Int // بالبايت
  mime       String
  folder     String   @default("") // "" = الجذر
  uploadedBy String? // معرّف المدير
  createdAt  DateTime @default(now())

  @@index([folder])
  @@map("platform_files")
}

// ═══ 8) المراسلات ══════════════════════════════

model MessagingProvider {
  id        String         @id @default(cuid())
  channel   MessageChannel
  name      String
  apiUrl    String // رابط API قالب
  method    String         @default("POST") // GET | POST
  apiKey    String?
  template  String? // قالب الرسالة: {phone} {message}
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@map("messaging_providers")
}

// قوالب رسائل الأحداث
model MessageTemplate {
  id        String         @id @default(cuid())
  event     String         @unique // otp | order_new | order_status | booking | card_verify...
  channel   MessageChannel @default(sms)
  body      String // نص القالب بمتغيرات {name} {code}...
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("message_templates")
}

// ═══ 9) الشكاوى ════════════════════════════════

model Complaint {
  id         String          @id @default(cuid())
  number     String          @unique // CMP-XXXXXX للتتبع
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id])
  name       String
  phone      String
  subject    String
  message    String
  reply      String?
  status     ComplaintStatus @default(open)
  createdAt  DateTime        @default(now())
  repliedAt  DateTime?

  @@map("complaints")
}

// ═══ 10) خدمات المنصة ══════════════════════════

model PlatformService {
  id          String                 @id @default(cuid())
  title       String
  description String? // وصف غني (HTML من محرر TipTap — مُطهّر في الخادم)
  price       Decimal                @db.Decimal(12, 2)
  currency    String                 @default("YER")
  image       String?
  videoUrl    String? // فيديو توضيحي: رابط يوتيوب أو ملف مرفوع /uploads/videos/…
  views       Int                    @default(0) // مشاهدات صفحة العرض
  isActive    Boolean                @default(true)
  sort        Int                    @default(0)
  orders      PlatformServiceOrder[]
  createdAt   DateTime               @default(now())

  @@map("platform_services")
}

model PlatformServiceOrder {
  id          String          @id @default(cuid())
  serviceId   String
  service     PlatformService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  details     String?
  proofImage  String? // إثبات التحويل
  // 🎁 خصم النقاط (يُسترد تلقائياً عند رفض الطلب)
  pointsUsed  Int             @default(0)
  discount    Decimal         @default(0) @db.Decimal(12, 2)
  finalAmount Decimal?        @db.Decimal(12, 2) // المبلغ بعد الخصم — ما يجب تحويله
  status      PaymentStatus   @default(pending)
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@map("platform_service_orders")
}

// ═══ 11) المحتوى والتصميم ══════════════════════

model Slide {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  image     String
  link      String?
  sort      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("slides")
}

// إعلانات المنصة — تُدار من لوحة المدير وتظهر في الرئيسية
// storeId موجود = إعلان مدفوع من بائع (يُفعّل بموافقة الإدارة على دفعته)
model Ad {
  id        String    @id @default(cuid())
  title     String
  image     String
  link      String?
  position  String    @default("home_top") // home_top | home_mid | home_bottom | store_top
  size      String    @default("wide") // hero عريض جداً | wide عريض | banner شريط | square مربع
  storeId   String? // إعلان بائع — فارغ يعني إعلان إدارة
  weeks     Int       @default(1) // مدة الإعلان المشتراة بالأسابيع
  sort      Int       @default(0)
  views     Int       @default(0)
  clicks    Int       @default(0)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([position, isActive])
  @@index([storeId])
  @@map("ads")
}

// 🔔 التنبيهات الداخلية — تُدفع تلقائياً عند الأحداث المهمة
model Notification {
  id          String   @id @default(cuid())
  userType    String // seller | customer
  userId      String
  icon        String   @default("🔔")
  title       String
  body        String?
  link        String?
  isRead      Boolean  @default(false)
  broadcastId String? // ربط التنبيه بحملة بث (لإحصائيات القراءة)
  createdAt   DateTime @default(now())

  @@index([userType, userId, isRead])
  @@index([broadcastId])
  @@map("notifications")
}

// 📡 حملات البث الجماعي — من الإدارة (لكل البائعين/الزبائن) أو من البائع (لزبائن متجره)
model Broadcast {
  id        String   @id @default(cuid())
  title     String
  body      String?
  link      String?
  audience  String // sellers | customers | store_customers
  storeId   String? // حملات البائع: المتجر صاحب الزبائن
  sentCount Int      @default(0)
  createdBy String // admin:<id> أو seller:<id>
  createdAt DateTime @default(now())

  @@index([createdBy])
  @@map("broadcasts")
}

model CustomPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  content      String // HTML من محرر Quill
  showInMenu   Boolean  @default(false)
  showInFooter Boolean  @default(true)
  sortOrder    Int      @default(0)
  views        Int      @default(0)
  isActive     Boolean  @default(true)
  metaTitle    String?
  metaDesc     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("custom_pages")
}

// إعدادات التصميم والمنصة (مفتاح/قيمة — تصدر إلى /css/theme.css)

model MessageLog {
  id        String         @id @default(cuid())
  event     String // الحدث: order_new | order_status | otp...
  channel   MessageChannel
  phone     String
  body      String // النص النهائي بعد التعويض
  status    String         @default("sent") // sent | failed | simulated
  provider  String? // اسم المزود المستخدم
  error     String?
  createdAt DateTime       @default(now())

  @@index([phone, event])
  @@map("message_logs")
}

// ─────────────────────────────────────────
model Setting {
  id        String   @id @default(cuid())
  group     String // theme | general | security | seo | about
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// 🤖 مزودو الذكاء الاصطناعي الخارجي — يضيفهم المدير الخارق لربط المنصة بأي واجهة برمجية
model AiProvider {
  id         String    @id @default(cuid())
  name       String // OpenAI / Anthropic / DeepSeek / مخصص...
  baseUrl    String // عنوان الواجهة البرمجية مثل https://api.openai.com/v1
  apiKey     String? // مشفر enc:v1: — لا يُرسل للواجهة أبداً
  model      String? // النموذج الافتراضي
  isActive   Boolean   @default(true)
  lastTestAt DateTime? // آخر فحص اتصال
  lastTestOk Boolean?
  createdAt  DateTime  @default(now())

  @@map("ai_providers")
}

// نسخ احتياطية من التصميم
model ThemeBackup {
  id        String   @id @default(cuid())
  name      String
  snapshot  Json
  createdAt DateTime @default(now())

  @@map("theme_backups")
}

// العملات وأسعار الصرف مقابل الدولار
// 💸 مصروفات المنصة التشغيلية — أساس قائمة الدخل الحقيقية
model Expense {
  id        String   @id @default(cuid())
  title     String // بيان المصروف
  category  String // hosting | marketing | salaries | fees | other
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("YER")
  spentAt   DateTime @default(now()) // تاريخ الاستحقاق الفعلي
  note      String?
  createdBy String? // المدير الذي سجّله
  createdAt DateTime @default(now())

  @@index([category, spentAt])
  @@map("expenses")
}

// 🔔 اشتراكات إشعارات الويب — تصل حتى والمتصفح مغلق
model PushSubscription {
  id        String   @id @default(cuid())
  userType  String // customer | seller | driver | admin
  userId    String
  endpoint  String   @unique
  keys      Json // { p256dh, auth }
  createdAt DateTime @default(now())

  @@index([userType, userId])
  @@map("push_subscriptions")
}

// 💬 المحادثة المباشرة — عميل ↔ متجر (بديل داخلي آمن عن واتساب)
model Conversation {
  id         String        @id @default(cuid())
  storeId    String
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())
  messages   ChatMessage[]

  @@unique([storeId, customerId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromType       String // customer | seller
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// 🔔 تنبيهات توفر المنتج — «أعلمني» عندما ينفد منتج يريده الزائر
model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  phone      String
  customerId String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, phone])
  @@index([productId])
  @@map("stock_alerts")
}

// 📱 طلبات تطبيقات الويب التقدمية للوحات — بائع/سائق/عميل يطلب، الإدارة توافق أو ترفض
model PwaRequest {
  id         String    @id @default(cuid())
  userType   String // seller | driver | customer
  userId     String
  userName   String?
  status     String    @default("pending") // pending | approved | rejected
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userType, userId])
  @@index([status, createdAt])
  @@map("pwa_requests")
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // YER | SAR | USD
  name      String
  symbol    String
  rateToUsd Decimal  @db.Decimal(14, 6)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

// المحافظات
model Governorate {
  id       String  @id @default(cuid())
  name     String
  nameEn   String?
  isActive Boolean @default(true)
  sort     Int     @default(0)

  @@map("governorates")
}

// ═══ 13) الأمن ═════════════════════════════════

model SecurityLog {
  id        String   @id @default(cuid())
  event     String // login_fail | login_success | ban | device...
  ip        String?
  userType  String?
  userId    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@map("security_logs")
}

model BannedIp {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String?
  bannedBy  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("banned_ips")
}

// أجهزة لوحة التحكم المعتمدة
model TrustedDevice {
  id          String       @id @default(cuid())
  adminId     String?
  fingerprint String       @unique
  name        String?
  status      DeviceStatus @default(pending)
  lastSeenAt  DateTime?
  createdAt   DateTime     @default(now())

  @@map("trusted_devices")
}

// ═══ 14) سجل النسخ الاحتياطية ══════════════════

model BackupRecord {
  id        String   @id @default(cuid())
  filename  String
  size      Int?
  note      String?
  createdAt DateTime @default(now())

  @@map("backup_records")
}

// ═══ 12) مفاتيح API العامة (الجلسة 17) ══════════════════

enum ApiKeyStatus {
  active
  revoked
}

model ApiKey {
  id         String       @id @default(cuid())
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // للعرض فقط: yzk_ab12cd34
  keyHash    String       @unique // sha256 — المفتاح الكامل لا يُخزن أبداً
  scopes     Json         @default("[\"store:read\",\"products:read\"]")
  ratePerMin Int          @default(60)
  totalCalls Int          @default(0)
  lastUsedAt DateTime?
  status     ApiKeyStatus @default(active)
  createdAt  DateTime     @default(now())
  usages     ApiUsage[]

  @@map("api_keys")
}

model ApiUsage {
  id    String @id @default(cuid())
  keyId String
  key   ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  day   String // YYYY-MM-DD
  calls Int    @default(0)
  fails Int    @default(0)

  @@unique([keyId, day])
  @@map("api_usage")
}

// ═══ ❤️ المفضلة — منتجات يحفظها العميل للرجوع إليها (الجلسة 1) ═══
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAtAdd Decimal? @db.Decimal(12, 2) // السعر عند الإضافة — لاكتشاف انخفاض السعر
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ═══ 💬 أسئلة وأجوبة المنتجات — العميل يسأل والبائع يجيب (الجلسة 2) ═══
model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  askerName  String // الاسم الظاهر حتى للزوار
  question   String
  answer     String?
  answeredAt DateTime?
  isPublic   Boolean   @default(true) // البائع يستطيع إخفاء سؤال مسيء
  createdAt  DateTime  @default(now())

  @@index([productId, createdAt])
  @@map("product_questions")
}

// ═══ 🛒 سلة السيرفر — مزامنة سلال العملاء + كشف السلات المهجورة (الجلسة 3) ═══
model CartItem {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String? // للزوار غير المسجلين
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    String? // وصف الخيار المعروض
  qty        Int       @default(1)
  price      Decimal   @db.Decimal(12, 2) // السعر الملتقط وقت المزامنة
  remindedAt DateTime? // آخر تذكير بالسلة المهجورة
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId, updatedAt])
  @@index([sessionId, updatedAt])
  @@map("cart_items")
}

// ─────────────────────────────────────────
// 🧰 تكنولوجيا المنصة — خدمات مجانية للزوار والتجار
model PlatformTool {
  key       String   @id
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  uses      Int      @default(0) // مرات فتح الخدمة (تفاعل)
  views     Int      @default(0) // زيارات صفحة الخدمة
  seoTitle  String? // 🔍 عنوان مخصص لمحركات البحث (تضبطه الإدارة)
  seoDesc   String? // وصف ميتا مخصص
  seoKeys   String? // كلمات مفتاحية مخصصة
  price     Decimal? @db.Decimal(12, 2) // 💰 فارغ/صفر = مجانية — غير ذلك تُشترى ببطاقة يمن زون
  updatedAt DateTime @updatedAt

  @@map("platform_tools")
}

// 🚀 «أضفني إلى محركات البحث» — أدلة المحلات التجارية المجانية بموقعها على الخريطة
model BizListing {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String // اسم المحل التجاري
  desc      String // ماذا يقدم
  keywords  String? // الكلمات الأساسية لمحركات البحث
  phone     String // اتصال
  whatsapp  String // واتساب
  website   String? // رابط إلكتروني اختياري
  note      String? // ملاحظة للإدارة
  category  String? // 📖 تصنيف النشاط (خدمات/مطاعم/صيدلية...)
  governorate String? // المحافظة
  lat       Float
  lng       Float
  status    String   @default("pending") // pending | approved | rejected
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("biz_listings")
}

// 🔗 صفحات «روابطي» المجانية — يبنيها الزائر ويشاركها برابط عام
model BioLink {
  id        String   @id @default(cuid())
  slug      String   @unique
  editKey   String // مفتاح سري يُحفظ في جهاز المنشئ لتعديل صفحته
  name      String
  data      Json
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bio_links")
}

// 🔗 «بع برابط واحد» — صفحة منتج فورية بلا متجر: يشاركها البائع فوراً وتتحول لبوابة دخوله للمنصة
model QuickSell {
  id          String   @id @default(cuid())
  slug        String   @unique // q + 8 hex
  name        String // اسم المنتج
  desc        String? // وصف مختصر
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("YER") // YER | SAR | USD
  images      Json     @default("[]") // ["/uploads/quick/x.webp"] — حتى 5
  whatsapp    String // رقم الطلب الأساسي
  phone       String? // اتصال اختياري
  governorate String? // المحافظة (اختياري)
  status      String   @default("active") // active | hidden (إشراف الإدارة)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("quick_sells")
}

// ♻️ سوق المستعمل — إعلانات مبوبة فورية للأفراد (سيارات/جوالات/أثاث...)
model UsedListing {
  id          String   @id @default(cuid())
  slug        String   @unique // u + 8 hex
  title       String // عنوان الإعلان
  desc        String? // تفاصيل الحالة والمواصفات
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("YER") // YER | SAR | USD
  category    String   @default("other") // cars | phones | electronics | realestate | furniture | clothes | other
  condition   String   @default("used-good") // like-new | used-good | used-fair
  images      Json     @default("[]") // ["/uploads/used/x.webp"] — حتى 5
  whatsapp    String // رقم التواصل الأساسي
  governorate String? // المحافظة (اختياري)
  status      String   @default("active") // active | hidden (إشراف الإدارة)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, category, createdAt])
  @@map("used_listings")
}

// 🔔 تنبيه نزول السعر للزوار — برقم الجوال دون تسجيل (المسجلون يُنبَّهون عبر المفضلة)
model PriceAlert {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  phone      String // جوال الزائر
  lastPrice  Decimal   @db.Decimal(12, 2) // السعر وقت الاشتراك — ننبّه عند النزول عنه
  notifiedAt DateTime? // آخر تنبيه أُرسل
  createdAt  DateTime  @default(now())

  @@unique([productId, phone])
  @@map("price_alerts")
}

// 📢 «اطلبها ونوفرها» — سوق الطلبات العكسي: العميل ينشر ما يبحث عنه والتجار يردون بعروضهم
model BuyerRequest {
  id           String   @id @default(cuid())
  slug         String   @unique // r + 8 hex
  title        String // ماذا يبحث عنه
  details      String?
  budget       Decimal? @db.Decimal(12, 2)
  currency     String   @default("YER")
  governorate  String?
  whatsapp     String // يصله ردود التجار عليه
  status       String   @default("pending") // pending | approved | closed
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  replies RequestReply[]

  @@index([status, createdAt])
  @@map("buyer_requests")
}

// 💬 ردود التجار على الطلبات — عروض بأسعار تُعرض تحت الطلب
model RequestReply {
  id         String   @id @default(cuid())
  requestId  String
  request    BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerName String // اسم التاجر أو المحل
  message    String
  price      Decimal? @db.Decimal(12, 2)
  whatsapp   String
  status     String   @default("pending") // pending | approved | hidden
  createdAt  DateTime @default(now())

  @@index([requestId, status])
  @@map("request_replies")
}

// 🧰 خدمات المستخدم — لكل مستخدم سجل بكل خدمة يضيفها إلى لوحته
// حقل data هو «قاعدة البيانات الخاصة بالخدمة»: كل خدمة يستخدمها المستخدم تخزّن بياناتها هنا مستقلة عن غيرها
model UserTool {
  id        String   @id @default(cuid())
  userType  String // seller | customer
  userId    String
  slug      String // مفتاح الخدمة (مثل debts / invoice / currency)
  data      Json? // 🗄️ بيانات الخدمة الخاصة بهذا المستخدم فقط
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userType, userId, slug])
  @@index([userType, userId])
  @@map("user_tools")
}

// 📢 مستند مشترك برابط عام قصير — منيو مطعم / اختبار / استطلاع / فعالية
// تنشئه الخدمات المدفوعة وتعرضه صفحة /s/[slug] بدون تسجيل دخول
model SharedDoc {
  id        String   @id @default(cuid())
  slug      String   @unique
  type      String // menu | quiz | poll | ticket
  ownerType String // seller | customer
  ownerId   String
  title     String   @default("")
  payload   Json // محتوى المستند (أقسام المنيو، أسئلة الاختبار، خيارات الاستطلاع وأصواتها...)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerType, ownerId])
  @@map("shared_docs")
}
