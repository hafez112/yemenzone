# يمن زون — دومين رئيسي + دومينات بديلة ديناميكية بشهادات TLS تلقائية
# أي دومين يُوجَّه لهذا الخادم يعمل فوراً بعد اعتماده من لوحة الإدارة (الأمن ← درع الحماية)
# الاعتماد يتم داخلياً وصامتاً عبر نقطة tls-ask — لا يظهر أي شيء للمستخدمين

{
	# إصدار الشهادات عند الطلب للدومينات المعتمدة فقط — يمنع إساءة الاستخدام
	# ⚠️ خيارا interval/burst أُلغيا في الإصدارات الحديثة من Caddy — وجودهما يمنع الإقلاع
	on_demand_tls {
		ask http://api:4000/api/v1/shield/tls-ask
	}
	# إخفاء بصمة الخادم
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	encode zstd gzip

	# طلبات API → خادم NestJS
	handle /api/* {
		reverse_proxy api:4000
	}

	# الصور والملفات المرفوعة → خادم NestJS
	handle /uploads/* {
		reverse_proxy api:4000
	}

	# كل ما تبقى → واجهة Next.js
	handle {
		reverse_proxy web:3000
	}

	# ترويسات أمان إضافية
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# 🌐 مقبِل عام: أي دومين معتمد داخلياً يُخدم بنفس المحتوى تلقائياً (شهادة عند الطلب)
:443 {
	tls {
		on_demand
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000
	}

	handle /uploads/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
