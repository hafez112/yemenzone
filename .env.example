# ── قاعدة البيانات ──────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yemenzone?schema=public"

# ── API ─────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
JWT_SECRET="change-me-super-secret-key-32chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32chars"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── الواجهة ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PLATFORM_DOMAIN=yemenzone.com
PORT=3000

# ── Google OAuth (الجلسة 2) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── بوابات الرسائل (الجلسة 12) ───────────────
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
