# ═══ يمن زون — متغيرات الإنتاج ═══
# انسخه إلى .env وعدّل القيم (أو دع deploy.sh يولّده لك)

# دومينك بدون https:// — مثال: yemenzone.com
DOMAIN=yemenzone.com

# قاعدة البيانات
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ضع-كلمة-مرور-قوية-هنا-24-حرف
POSTGRES_DB=yemenzone

# أسرار JWT — ولّدها: openssl rand -hex 32
JWT_SECRET=ضع-64-حرف-عشوائي
JWT_REFRESH_SECRET=ضع-64-حرف-عشوائي-آخر
